# Gophish Environment Configuration
# Copy this file to .env and update the values

# ============================================
# Database Configuration
# ============================================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gophish
DB_USER=gophish
DB_PASSWORD=ChangeMe123!

# ============================================
# Server Configuration
# ============================================
ADMIN_SERVER_HOST=127.0.0.1
ADMIN_SERVER_PORT=3333
PHISH_SERVER_HOST=0.0.0.0
PHISH_SERVER_PORT=80

# ============================================
# SSL Configuration
# ============================================
SSL_CERT_PATH=/opt/gophish/gophish.crt
SSL_KEY_PATH=/opt/gophish/gophish.key

# ============================================
# Domain Configuration
# ============================================
DOMAIN=gophish.savanamed.com

# ============================================
# Security
# ============================================
CSRF_KEY=GenerateA32CharacterRandomStringHere
SECRET_KEY=GenerateA64CharacterRandomStringHere

# ============================================
# Contact
# ============================================
CONTACT_ADDRESS=security@savanamed.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
